# ── Java / Maven 构建产物 ──
*.class
target/

# ── 依赖包归档 ──
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ── 日志与 JVM 崩溃转储 ──
*.log
hs_err_pid*
replay_pid*

# ── 本地配置（含 API keys，不进版本库）──
application-local.yml
application-local.properties
.env*

# ── 运行时数据：SQLite 正本 + Qdrant 向量 ──
/data/

# ── IDE ──
.idea/

# ── Playwright MCP 临时目录（测试截图，由 .claude 钩子自动清理）──
.playwright-mcp/
